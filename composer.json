{
  "name": "bestuniverse/laravel-toolkit",
  "type": "library",
  "require": {
    "php": "^8.3",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5|^12.0"
  },
  "scripts": {
    "test": "phpunit"
  },
  "autoload": {
    "psr-4": {
      "Bestuniverse\\LaravelToolkit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bestuniverse\\LaravelToolkit\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Bestuniverse\\LaravelToolkit\\LaravelToolkitServiceProvider"
      ]
    }
  }
}
